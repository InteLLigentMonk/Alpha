@{
    Layout = "../Shared/_LayoutAuth.cshtml";
	string buttonName = "Login with Google";
	ViewData["Title"] = "Login";
}
<link rel="stylesheet" href="~/css/login.css" />
<h1>@ViewData["Title"]</h1>
<partial name="Partials/UI/_ButtonGooglePartial" model=buttonName />
<div class="or-divider">
    <div class="ruler"></div>
    <div>OR</div>
    <div class="ruler"></div>
</div>
<partial name="Partials/_LoginFormPartial" />
<div class="no-account center">
    <p>Don't have an account? <a asp-action="Register">Sign up</a></p>
</div>

<partial name="Partials/_FormValidationPartial" />
