@model ProjectFormViewModel;
@{
    var selectedMembersList = Model.Members ?? new List<Member>();
    var availableMembers = ViewData["Members"] as List<Member> ?? new List<Member>();

    // Create JSON strings with minimal whitespace
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = false };
    var membersJson = System.Text.Json.JsonSerializer.Serialize(availableMembers, jsonOptions);
    var selectedMembersJson = System.Text.Json.JsonSerializer.Serialize(selectedMembersList, jsonOptions);
}

<style>

    .member-input-wrapper {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        border: 1px solid var(--border);
        padding: 5px;
        border-radius: 8px;
        min-height: 40px;
    }

    .member-input-wrapper:has(#member-input:focus) {
        box-shadow: var(--shadow-input);
    }

    #selected-members {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .member-chip {
        display: flex;
        align-items: center;
        background-color: var(--muted);
        border-radius: 4px;
        padding: 5px 10px;
        font-size: 14px;
    }

    .member-chip img {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        margin-right: 5px;
        object-fit: cover;
    }

    .remove-btn {
        cursor: pointer;
        margin-left: 5px;
        color: var(--color-bodylight);
    }

    #member-input {
        border: none;
        outline: none;
        box-shadow: none;
        flex-grow: 1;
        padding: 5px;
    }

    .suggestions-list {
        list-style: none;
        padding: 0;
        margin: 5px 0 0;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: var(--card);
        max-height: 150px;
        overflow-y: auto;
        display: none;
        position: absolute;
        width: 390px;
        z-index: 101;
    }

    .suggestions-list li {
        padding: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .suggestions-list li:hover {
        background-color: var(--muted);
    }

    .suggestions-list img {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        margin-right: 10px;
        object-fit: cover;
    }

</style>

<div class="member-container">
    <label asp-for="Members">Members</label>
    <div class="member-input-wrapper">
        <div id="selected-members"></div>
        <input type="text" id="member-input" name="member-input" placeholder="Search members...">
    </div>
        <span asp-validation-for="Members"></span>
    <ul id="suggestions" class="suggestions-list"></ul>
</div>

<!-- Store data in hidden divs that can be easily accessed after AJAX loading -->
<div id="members-data" style="display:none;">@membersJson</div>
<div id="selected-members-data" style="display:none;">@selectedMembersJson</div>
