@model WebApp.Models.ForgotPasswordFormViewModel

<form method="post" class="login-form mb-2">
    <div class="form-input">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="input" autofocus>
        <span asp-validation-for="Email"></span>
    </div>
        @await Html.PartialAsync("Partials/UI/_ButtonPrimaryPartial", new ButtonPropertiesModel() { Text = "Reset Password" })
    <a asp-action="Login" class="mt-2">
        @await Html.PartialAsync("Partials/UI/_ButtonSecondaryPartial", new ButtonPropertiesModel() { Text = "Cancel", Type="button" })
    </a>
</form>

