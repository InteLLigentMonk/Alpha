@model ProfileFormViewModel

<div class="modal-heading">
    <h3 id="modal-title">New Member</h3>
    <span id="btn-close" class="close" data-bs-dismiss="modal">&times;</span>
</div>

<form asp-action="AddMember" asp-controller="Admin" method="post" enctype="multipart/form-data" id="add-member-form" class="projects-form">
    <div class="photo-upload-button">
        <label asp-for="Avatar">
            <div id="photo-placeholder" class="photo-placeholder-square ">
                <div class="camera-circle">
                    <i class="fa-solid fa-camera-retro fa-2xl"></i>
                </div>
            </div>

            <img id="member-img" class="upload-image d-none" src="#" />
        </label>
        <input asp-for="Avatar" data-user-id="@Model.Id" accept="image/*" class="input">
    </div>
    <span asp-validation-for="Avatar"></span>

    <div class="form-group">
        <div class="form-input">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="input">
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="form-input">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="input">
            <span asp-validation-for="LastName"></span>
        </div>
    </div>
    <div class="form-input">
        <label asp-for="Email"></label>
		@if (!string.IsNullOrEmpty(Model.Email))
		{
			<input asp-for="Email" class="input" readonly>
		}
		else
		{
			<input asp-for="Email" class="input">
		}
        <span asp-validation-for="Email"></span>
    </div>
    <div class="form-input">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="input">
        <span asp-validation-for="PhoneNumber"></span>
    </div>
    <div class="form-group">
        <div class="form-input">
            <label asp-for="StreetAddress"></label>
            <input asp-for="StreetAddress" class="input">
            <span asp-validation-for="StreetAddress"></span>
        </div>
        <div class="form-input w-25">
            <label asp-for="StreetNumber"></label>
            <input asp-for="StreetNumber" class="input">
            <span asp-validation-for="StreetNumber"></span>
        </div>
    </div>
    <div class="form-group">
        <div class="form-input w-25">
            <label asp-for="ZipCode"></label>
            <input asp-for="ZipCode" class="input">
            <span asp-validation-for="ZipCode"></span>
        </div>
        <div class="form-input">
            <label asp-for="City"></label>
            <input asp-for="City" class="input">
            <span asp-validation-for="City"></span>
        </div>
    </div>
    <div class="form-input">
        <label asp-for="JobTitle"></label>
        <input asp-for="JobTitle" class="input">
        <span asp-validation-for="JobTitle"></span>
    </div>

    <div>
        <label class="mb-2">Date of Birth</label>
        <div class="form-group">
            <div class="d-flex gap-2">
                <select asp-for="Day" class="input">
                    @for (int day = 1; day <= 31; day++)
                    {
                        if (day == 1)
                        {
                            <option value="@day" selected>@day.ToString("D2")</option>
                        }
                        else
                        {
                            <option value="@day">@day.ToString("D2")</option>
                        }
                    }
                </select>
                <select asp-for="Month" class="input">
                    @for (int month = 1; month <= 12; month++)
                    {
                        if (month == 1)
                        {
                            <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                        }
                        else
                        {
                            <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                        }
                    }
                </select>
                <select asp-for="Year" class="input">
                    @for (int year = DateTime.Now.Year; year >= 1901; year--)
                    {

                        if (year == 1901)
                        {
                            <option value="@year" selected>@year</option>
                        }
                        else
                        {
                            <option value="@year">@year</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>
    <button id="btn-member" class="btn btn-primary w-100">Add Member</button>
</form>