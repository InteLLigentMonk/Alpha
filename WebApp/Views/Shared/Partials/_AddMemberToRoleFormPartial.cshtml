@model AssignRoleToUserFormViewModel
@{
	var users = ViewData["Users"] as List<SimpleUser>;
	var roles = ViewData["Roles"] as List<AppRole>;
}

<div class="modal-heading">
    <h3 id="modal-title">Add a role</h3>
    <span id="btn-close" class="close" data-bs-dismiss="modal">&times;</span>
</div>

<form asp-action="AddMemberToRole" asp-controller="Role" method="post" id="add-member-to-role-form" class="projects-form">
    <div class="form-input">
        <label asp-for="UserId"></label>
        <select asp-for="UserId" class="input">
            @foreach (var user in users!)
            {
                <option value="@user.Id">@user.Email</option>
            }
        </select>
        <span asp-validation-for="UserId"></span>
    </div>
    <div class="form-input">
        <label asp-for="RoleName"></label>
        <select asp-for="RoleName" class="input">
            @foreach (var role in roles!)
            {
                <option value="@role.Name">@role.Name</option>
            }
        </select>
        <span asp-validation-for="RoleName"></span>
    </div>
    <button id="btn-project" class="btn btn-primary w-100">Add</button>
</form>
