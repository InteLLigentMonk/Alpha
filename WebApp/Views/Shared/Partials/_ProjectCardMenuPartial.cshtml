@model ProjectFormViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
<div id="card-menu-@Model.Id" class="card project-menu-card">
    <div class="edit-menu-card-frame">
        <div class="project-finished">
            <a asp-action="Finish" asp-controller="Project" asp-route-id="@Model.Id">
                <div id="btn-edit-member" class="btn btn-dropdown w-100">
                    <i class="fa-duotone fa-solid fa-check-to-slot"></i>
                    @if (!Model.Finished)
                    {
                        <span>Mark as Finished</span>

                    }
                    else
                    {
                        <span>Mark as Unfinished</span>
                    }
                </div>
            </a>
        </div>
        <div class="edit">
            <button id="btn-edit-member" class="btn btn-dropdown w-100" onclick='loadEditModal("Project","edit-project-form", "@Model.Id")'>
                <i class="fa-duotone fa-solid fa-pen-to-square"></i>
                Edit
            </button>
        </div>
        <div class="add-member">
            <button id="btn-edit-member" class="btn btn-dropdown w-100" onclick='loadMembersModal("Project","add-member-to-project-form", "@Model.Id")'>
                <i class="fa-duotone fa-solid fa-user-plus"></i> 
                Edit Members
            </button>
        </div>
    </div>
    <div class="mt-2">
        <div class="delete">
            <a asp-action="Delete" asp-controller="Project" asp-route-id="@Model.Id">
                <div class="btn btn-delete w-100">
                    <i class="fa-duotone fa-solid fa-trash-can"></i>
                    <p>Delete</p>
                </div>
            </a>
        </div>
    </div>
</div>