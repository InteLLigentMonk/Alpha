<aside class="sidebar">
    <a asp-action="Dashboard" asp-controller="Home" class="btn btn-sidebar @(Context.Request.Path == "/" ? "active" : "")">
        <i class="fa-duotone fa-solid fa-xl fa-objects-column"></i>
        <span class="sidebar-button-text">Dashboard</span>
    </a>
    <a asp-action="All" asp-controller="Project" class="btn btn-sidebar @(Context.Request.Path == "/project/all" ? "active" : "")">
        <i class="fa-duotone fa-solid fa-xl fa-briefcase"></i>
        <span class="sidebar-button-text">Projects</span>
    </a>
    <a asp-action="Members" asp-controller="Member" class="btn btn-sidebar @(Context.Request.Path == "/member/members" ? "active" : "")">
        <i class="fa-duotone fa-solid fa-xl fa-users"></i>
        <span class="sidebar-button-text">Team Members</span>
    </a>
    @if (User.IsInRole("Management") || User.IsInRole("Admin"))
    {
        <a asp-action="JobTitles" asp-controller="JobTitle" class="btn btn-sidebar @(Context.Request.Path == "/jobtitle/jobtitles" ? "active" : "")">
            <i class="fa-duotone fa-solid fa-xl fa-id-badge"></i>
            <span class="sidebar-button-text">Job Titles</span>
        </a>
    }
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Roles" asp-controller="Role" class="btn btn-sidebar @(Context.Request.Path == "/role/roles" ? "active" : "")">
            <i class="fa-duotone fa-solid fa-xl fa-users-gear"></i>
            <span class="sidebar-button-text">Role Adm.</span>
        </a>
    }
</aside>
