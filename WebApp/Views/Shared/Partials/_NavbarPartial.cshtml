@{
    var profile = ViewBag.Profile as Profile;
    // set greetingName to email but only chars before the @ sign
    var greetingName = userManager.GetUserName(User)!.Split('@')[0];
    string avatarUrl = "/icons/avatars/1.svg";
    if(profile != null)
    {
        if (profile.AvatarUrl != null)
        {
            avatarUrl = $"/uploads/{profile.AvatarUrl}";
        }

        if(!string.IsNullOrEmpty(profile.FirstName) && !string.IsNullOrEmpty(profile.LastName))
        {
            greetingName = $"{profile.FirstName} {profile.LastName}";
        }

    }
}
<nav class="navbar w-100 navbar-expand-md">
    <div class=" container-fluid justify-content-between gap-2" >
        <partial name="Partials/_SearchFormPartial"/>
        <div class="d-md-none" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <div class="avatar-img">
                <img src="@avatarUrl" alt="your avatar" />
            </div>
        </div>

        <div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item dropdown">
                    <a class="nav-link" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-bell fa-lg"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                        Hej på dej
                    </div>
                    
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-gear fa-lg"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                        <div class="current-user">
                            <div class="avatar-img">
                                <img src="@avatarUrl" alt="your avatar" />
                            </div>
                            <h6>
                                @greetingName
                            </h6>
                            
                        </div>
                        <div class="form-check form-switch darkmode">
                            <div class="d-flex gap-2 align-items-center">
                                <i class="fa-solid fa-gear"></i>
                                <p>Dark Mode</p>
                            </div>
                            <input class="form-check-input" type="checkbox" id="flexSwitchCheckChecked" checked="checked">
                        </div>
                        <div class="settings">
                            <a asp-action="Profile" asp-controller="Home">
                                <i class="fa-duotone fa-solid fa-address-card"></i>
                                <span>Profile</span>
                            </a>
                        </div>
                        <div class="logout">
                            <a asp-action="Logout" asp-controller="Auth">
                                <i class="fa-duotone fa-solid fa-right-from-bracket"></i>
                                <span>Logout</span>
                            </a>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</nav>