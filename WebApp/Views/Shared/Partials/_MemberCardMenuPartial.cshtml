@model ProfileFormViewModel

<div id="card-menu-@Model.Id" class="card project-menu-card">
    <div class="edit">
        <button id="btn-edit-member" class="btn btn-dropdown w-100" onclick="loadEditModal('Member','edit-member-form','@Model.UserId')">
            <i class="fa-solid fa-pen-to-square"></i>
             Edit
        </button>
    </div>
    <div class="delete">
        <a asp-action="Delete" asp-controller="Member" asp-route-id="@Model.UserId">
            <div class="btn btn-delete w-100">
                <i class="fa-solid fa-trash-can"></i>
                <p>Delete</p>
            </div>
        </a>
    </div>
</div>
