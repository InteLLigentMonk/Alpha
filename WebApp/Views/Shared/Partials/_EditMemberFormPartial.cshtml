@model ProfileFormViewModel
@{
    var jobTitles = ViewData["JobTitles"] as List<JobTitle> ?? new List<JobTitle>();
    var test = "test";
}

<div class="modal-heading">
    <h3 id="modal-title">Edit Member</h3>
    <span id="btn-close" class="close" data-bs-dismiss="modal">&times;</span>
</div>

<form asp-action="Edit" asp-controller="Member" method="post" enctype="multipart/form-data" id="edit-member-form" class="projects-form">
    <input name="Id" id="Id" data-val="false" class="d-none" value="@Model.Id" />
    <input name="UserId" id="UserId" data-val="false" class="d-none" value="@Model.UserId" />
    <input name="AvatarUrl" id="AvatarUrl" data-val="false" class="d-none" value="@Model.AvatarUrl"/>
    <div class="photo-upload-button">
        <label asp-for="Avatar">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <div id="photo-placeholder" data-user-id="@Model.Id" class="photo-placeholder-square d-none">
                    <div class="camera-circle">
                        <i class="fa-solid fa-camera-retro fa-2xl"></i>
                    </div>
                </div>

                <img class="upload-image" data-user-id="@Model.Id" src="~/uploads/@Model.AvatarUrl" />
            }
            else
            {
                <div id="photo-placeholder" class="photo-placeholder-square ">
                    <div class="camera-circle">
                        <i class="fa-solid fa-camera-retro fa-2xl"></i>
                    </div>
                </div>

                <img class="upload-image d-none" src="#" />
            }
        </label>
        <input asp-for="Avatar" data-user-id="@Model.Id" accept="image/*" class="input">
    </div>
    <span asp-validation-for="Avatar"></span>

    <div class="form-group">
        <div class="form-input">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="input">
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="form-input">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="input">
            <span asp-validation-for="LastName"></span>
        </div>
    </div>
    <div class="form-input">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="input" readonly>
        <span asp-validation-for="Email"></span>
    </div>
    <div class="form-input">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="input">
        <span asp-validation-for="PhoneNumber"></span>
    </div>
    <div class="form-group">
        <div class="form-input">
            <label asp-for="StreetAddress"></label>
            <input asp-for="StreetAddress" class="input">
            <span asp-validation-for="StreetAddress"></span>
        </div>
        <div class="form-input w-25">
            <label asp-for="StreetNumber"></label>
            <input asp-for="StreetNumber" class="input">
            <span asp-validation-for="StreetNumber"></span>
        </div>
    </div>
    <div class="form-group">
        <div class="form-input w-25">
            <label asp-for="ZipCode"></label>
            <input asp-for="ZipCode" class="input">
            <span asp-validation-for="ZipCode"></span>
        </div>
        <div class="form-input">
            <label asp-for="City"></label>
            <input asp-for="City" class="input">
            <span asp-validation-for="City"></span>
        </div>
    </div>
    <div class="form-input">
        <label asp-for="Country"></label>
        <input asp-for="Country" class="input">
        <span asp-validation-for="Country"></span>
    </div>
    <div class="form-input">
        <label asp-for="JobTitle"></label>
        <select asp-for="JobTitle" class="input">
            @foreach (var jobTitle in jobTitles)
            {
				if (jobTitle.Id == Model.JobTitle)
				{
					<option value="@jobTitle.Id" selected>@jobTitle.Title</option>
				}
				else
				{
					<option value="@jobTitle.Id">@jobTitle.Title</option>
				}
            }
        </select>
        <span asp-validation-for="JobTitle"></span>
    </div>

    <div>
        <label class="mb-2">Date of Birth</label>
        <div class="form-group">
            <div class="d-flex gap-2">
                <select asp-for="Day" class="input">
                    @for (int day = 1; day <= 31; day++)
                    {
                        if(day == Model.Day)
                        {
                            <option value="@day" selected >@day.ToString("D2")</option>
                        } 
                        else
                        {
                            <option value="@day">@day.ToString("D2")</option>
                        }
                    }
                </select>
                <select asp-for="Month" class="input">
                    @for (int month = 1; month <= 12; month++)
                    {
                        if (month == Model.Month)
                        {
                            <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                        }
                        else
                        {
                            <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                        }
                    }
                </select>
                <select asp-for="Year" class="input">
                    @for (int year = DateTime.Now.Year; year >= 1901; year--)
                    {
                        
                        if (year == Model.Year)
                        {
                            <option value="@year" selected>@year</option>
                        }
                        else
                        {
                            <option value="@year">@year</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>
    <button class="btn btn-primary w-100">Save</button>
</form>