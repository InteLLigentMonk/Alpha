@model ProjectsViewModel
@{
    Layout = "../Shared/_Layout.cshtml";
    ViewData["Title"] = "Projects";
}

<div class="projects-title">
    <h2>Projects</h2>
    <button id="btn-new-project" class="btn btn-primary" onclick="toggleModal('newProjectModal', 'btn-new-project-close', 'add-project-form')"><i class="fa-solid fa-plus"></i> Add Project</button>
</div>

<div class="projects-statusbar">
    <button class="projects-statusbar-tab">All [15]</button>
    <button class="projects-statusbar-tab">Started [9]</button>
    <button class="projects-statusbar-tab">Completed [6]</button>
</div>

<div class="main-grid">
    <partial name="Partials/_ProjectCardPartial" />
</div>


@* Project Modal *@
<div id="newProjectModal" class="modal">
    <div class="card modal-content">
        <div class="modal-heading">
            <h3>Add Project</h3>
            <span id="btn-new-project-close" class="close">&times;</span>
        </div>
        @await Html.PartialAsync("Partials/_AddProjectFormPartial", Model.ProjectForm)
    </div>
</div>

@await Html.PartialAsync("Partials/_FormValidationPartial")
