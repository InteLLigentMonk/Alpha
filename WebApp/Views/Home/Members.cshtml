@using System.Security.Claims
@model MembersViewModel
@{
    Layout = "../Shared/_Layout.cshtml";
    ViewData["Title"] = "Team Members";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);  
}




<div class="projects-title">
    <h2>@ViewData["Title"]</h2>
    <button id="btn-new-member" class="btn btn-primary" onclick='loadCreateModal("Admin", "add-member-form")'><i class="fa-solid fa-plus"></i> Team Member</button>
</div>
<div class="main-grid">
    @foreach (var member in Model.Members)
    {

        if (member.Id.ToString() != userId)
        {
            var profileViewModel = new ProfileFormViewModel
                {
                    Id = member.Id,
					UserId = member.UserId,
                    FirstName = member.FirstName,
                    LastName = member.LastName,
                    Email = member.EmailAddress!,
                    PhoneNumber = member.PhoneNumber,
                    StreetAddress = member.StreetAddress,
                    StreetNumber = member.StreetNumber,
                    ZipCode = member.ZipCode,
                    City = member.City,
                    Country = member.Country,
                    JobTitle = member.JobTitle,
                    AvatarUrl = member.AvatarUrl,
                    Day = member.DateOfBirth!.Value.Day,
                    Month = member.DateOfBirth.Value.Month,
                    Year = member.DateOfBirth.Value.Year


                };
            <partial name="Partials/_MemberCardPartial"
                     model="@profileViewModel" />
        }

    }
</div>


<div class="modal fade custom-modal" id="formModal" tabindex="-1" ariea-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="modal-content">

        </div>
    </div>
</div>

<partial name="Partials/_FormValidationPartial"/>
